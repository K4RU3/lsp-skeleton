{
  "name": "lsp-skeleton",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LSP-backed skeleton / deps / expand for TypeScript, with MCP and DeepSeek Harness adapters",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "lsp-skeleton": "./dist/cli.js",
    "lsp-skeleton-mcp": "./dist/adapters/mcp/server.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dsh": {
      "types": "./dist/adapters/dsh/plugin.d.ts",
      "default": "./dist/adapters/dsh/plugin.js"
    },
    "./mcp": {
      "types": "./dist/adapters/mcp/server.d.ts",
      "default": "./dist/adapters/mcp/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test 'test/*.test.ts'",
    "probe": "node --experimental-strip-types scripts/probe-servers.ts",
    "fixture:setup": "node --experimental-strip-types scripts/setup-fixture.ts",
    "mcp": "node --experimental-strip-types src/adapters/mcp/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@vtsls/language-server": "^0.3.0",
    "typescript": "^5.9.3",
    "typescript-language-server": "^6.0.3",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "^0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-working-directory": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "^0.2.1-rc.2",
    "@types/node": "^24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
